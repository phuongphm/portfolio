                  <span class="text-[#93a18e]" aria-hidden="true">/</span>
                  <span class="text-[#dfead8]">Encouraging Study Scholarship</span>
                </div>
              </div>
            </div>

            <div class="relative">
              <div class="education-float absolute -left-4 -top-4 h-16 w-16 rounded-2xl border border-white/20 bg-[#cfe8b3]/90" aria-hidden="true"></div>
