        <p>Teaching curiosity, one project at a time.</p>
        <a href="#about" class="transition-colors hover:text-[#20372b]">Back to top ↑</a>
      </footer>
    </main>
    <script>
      document.querySelectorAll<HTMLAnchorElement>("[data-vietnamese-href]").forEach((link) => {
        link.addEventListener("click", () => {
          if (window.localStorage.getItem("site-language") === "vi" && link.dataset.vietnameseHref) {
            link.href = link.dataset.vietnameseHref;
          }
        });
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", (event) => {
          const target = document.querySelector<HTMLElement>(link.hash);
          if (!target) return;

          event.preventDefault();
          target.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
          });
          window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
        });
      });

      const awardLightbox = document.querySelector<HTMLDialogElement>("#award-certificate-lightbox");
      const awardLightboxImage = document.querySelector<HTMLImageElement>("[data-award-lightbox-image]");
      const oxfordLightbox = document.querySelector<HTMLDialogElement>("#oxford-certificate-lightbox");
      const certificateLightbox = document.querySelector<HTMLDialogElement>("#certificate-lightbox");
      const certificateFrame = document.querySelector<HTMLIFrameElement>("[data-certificate-frame]");
      const certificateTitle = document.querySelector<HTMLParagraphElement>("[data-certificate-title]");

      if (awardLightbox && awardLightboxImage) {
        document.querySelectorAll<HTMLButtonElement>("[data-award-lightbox]").forEach((button) => {
          button.addEventListener("click", () => {
            const certificate = button.parentElement?.querySelector("img");
            if (!certificate) return;

            awardLightboxImage.src = certificate.currentSrc || certificate.src;
            awardLightboxImage.alt = certificate.alt;
            awardLightbox.showModal();
          });
        });

        awardLightbox.querySelector("[data-close-award-lightbox]")?.addEventListener("click", () => {
          awardLightbox.close();
        });
        awardLightbox.addEventListener("click", (event) => {
          if (event.target === awardLightbox) awardLightbox.close();
        });
      }

      if (oxfordLightbox) {
        document.querySelector<HTMLButtonElement>("[data-oxford-certificate-open]")?.addEventListener("click", () => {
          oxfordLightbox.showModal();
        });
        oxfordLightbox.querySelector("[data-close-oxford-lightbox]")?.addEventListener("click", () => {
          oxfordLightbox.close();
        });
        oxfordLightbox.addEventListener("click", (event) => {
          if (event.target === oxfordLightbox) oxfordLightbox.close();
        });
      }

      if (certificateLightbox && certificateFrame && certificateTitle) {
        document.querySelectorAll<HTMLButtonElement>("[data-certificate-open], [data-project-certificate]").forEach((button) => {
          button.addEventListener("click", () => {
            const certificateUrl = button.dataset.certificateUrl;
            const title = button.dataset.certificateTitle;
            if (!certificateUrl || !title) return;

            certificateFrame.src = certificateUrl;
            certificateFrame.title = title;
            certificateTitle.textContent = title;
            certificateLightbox.showModal();
          });
        });

        const closeCertificate = () => {
          certificateLightbox.close();
          certificateFrame.removeAttribute("src");
        };

        certificateLightbox.querySelector("[data-close-certificate]")?.addEventListener("click", closeCertificate);
        certificateLightbox.addEventListener("click", (event) => {
          if (event.target === certificateLightbox) closeCertificate();
        });
        certificateLightbox.addEventListener("close", () => {
          certificateFrame.removeAttribute("src");
        });
      }
    </script>
  </body>
</html>
