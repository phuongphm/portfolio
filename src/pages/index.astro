            <li><a href="#awards" class="rounded-full px-2 py-2 transition-colors hover:text-[#20372b]">Awards</a></li>
            <li><a href="#blog" class="rounded-full px-2 py-2 transition-colors hover:text-[#20372b]">Blog</a></li>
            <li><a href="#contact" class="rounded-full px-2 py-2 transition-colors hover:text-[#20372b]">Contact</a></li>
