              <div class="relative rounded-[1.75rem] border border-white/10 bg-[#f5f3ec] p-5 text-[#20372b] shadow-[0_18px_40px_rgba(0,0,0,0.12)]">
                <div class="mb-4 flex items-center justify-between gap-3">
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#456047]">Relevant courses</p>
