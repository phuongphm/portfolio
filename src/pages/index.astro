                <svg viewBox="0 0 24 24" class="size-6 fill-none stroke-current" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M7.2 3.5h2.6l1.3 4.1-1.8 1.7a15.1 15.1 0 0 0 5.4 5.4l1.7-1.8 4.1 1.3v2.6a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 5.2 5.7a2 2 0 0 1 2-2.2Z" />
