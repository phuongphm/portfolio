---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroImage from "../assets/hero.png";
import iloCertificate from "../assets/ILO.jpg";
import safeguardingCertificate from "../assets/218_3_92322_1787894364_Default course certificate.pdf?url";
import teachingLearnersCertificate from "../assets/Teaching to Young Learner.jpg";
import oxfordCertificate from "../assets/oxford.pdf?url";
import unescoCertificate from "../assets/UNESCO.pdf?url";
import aiRiserCertificate from "../assets/AI RISER.pdf?url";
import snapologyLogo from "../assets/Snapology.png";
import mindxLogo from "../assets/Mindx.png";
import tageduLogo from "../assets/TagEdu.png";
import digiuniLogo from "../assets/digiuni.png";
import "../styles/global.css";
import LanguageSwitch from "../components/LanguageSwitch.astro";

const name = "Phuong Pham";
const role = "Coding Teacher";
const allBlogPosts = await getCollection("blog", ({ data }) => !data.draft);
const localizedBlogPosts = new Map(
  allBlogPosts
    .filter((post) => post.data.language === "vi")
    .map((post) => [post.data.translationKey ?? post.id, post]),
);
const blogPosts = allBlogPosts.filter((post) => post.data.language === "en").sort(
  (first, second) =>
    (second.data.pubDate?.getTime() ?? 0) - (first.data.pubDate?.getTime() ?? 0),
);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="The portfolio of Phuong Pham, coding teacher and STEM educator."
    />
    <meta name="theme-color" content="#f5f3ec" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <title>{name} — {role}</title>
  </head>

  <body class="bg-[#f5f3ec] text-[#20372b] antialiased">
    <main class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
      <header class="sticky top-0 z-50 flex flex-wrap items-center justify-between gap-5 bg-[#f5f3ec] py-5">
        <a href="#about" class="group flex items-center gap-3" aria-label="Phuong Pham, home">
          <span class="flex size-10 items-center justify-center rounded-full bg-[#20372b] text-lg font-semibold text-[#cfe8b3] transition-transform group-hover:rotate-12">
            P
