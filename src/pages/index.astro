                    <span class="text-sm leading-6 text-[#20372b]">Phonetics and Phonology</span>
                    <span class="rounded-full bg-[#edf7e5] px-2.5 py-1 text-xs font-semibold text-[#456047]">4.0/4.0</span>
                  </li>
                  <li class="course-item flex items-center justify-between gap-4 rounded-2xl bg-white px-3 py-3 shadow-sm ring-1 ring-[#20372b]/5">
                    <span class="text-sm leading-6 text-[#20372b]">Business Communication Skills</span>
                    <span class="rounded-full bg-[#edf7e5] px-2.5 py-1 text-xs font-semibold text-[#456047]">3.0/4.0</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </article>
      </section>

