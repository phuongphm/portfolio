            </>
          )}
        </div>
        <dialog
          id="experience-lightbox"
          aria-label="Expanded experience photo"
          class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-black/90 p-4 text-white backdrop:bg-black/80 sm:p-8"
        >
          <div class="flex h-full w-full flex-col items-center justify-center gap-3">
            <button
              type="button"
              data-close-experience-lightbox
              class="absolute right-4 top-4 z-10 flex size-11 items-center justify-center rounded-full bg-white/15 text-2xl leading-none text-white transition-colors hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-8 sm:top-8"
              aria-label="Close expanded photo"
            >
              &times;
            </button>
            <img
              data-experience-lightbox-image
              class="max-h-[85vh] max-w-full rounded-xl object-contain shadow-2xl"
              alt=""
            />
            <p data-experience-lightbox-caption class="text-center text-sm font-medium text-white/85"></p>
          </div>
        </dialog>
        <a href={`${import.meta.env.BASE_URL}#experience`} class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#20372b] px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-[#456047]">
          <span aria-hidden="true">←</span>
          Back to experience
        </a>
      </section>
    </main>
    <script>
      const experienceLightbox = document.querySelector<HTMLDialogElement>("#experience-lightbox");
      const experienceLightboxImage = document.querySelector<HTMLImageElement>("[data-experience-lightbox-image]");
      const experienceLightboxCaption = document.querySelector<HTMLParagraphElement>("[data-experience-lightbox-caption]");

      if (experienceLightbox && experienceLightboxImage && experienceLightboxCaption) {
        document.querySelectorAll<HTMLButtonElement>("[data-experience-lightbox]").forEach((button) => {
          button.addEventListener("click", () => {
            const thumbnail = button.parentElement?.querySelector("img");
            if (!thumbnail) return;

            const caption = button.parentElement?.querySelector("[data-experience-caption]");
            experienceLightboxImage.src = thumbnail.currentSrc || thumbnail.src;
            experienceLightboxImage.alt = thumbnail.alt;
            experienceLightboxCaption.textContent = caption?.textContent?.trim() ?? thumbnail.alt;
            experienceLightbox.showModal();
          });
        });

        experienceLightbox.querySelector("[data-close-experience-lightbox]")?.addEventListener("click", () => {
          experienceLightbox.close();
        });
        experienceLightbox.addEventListener("click", (event) => {
          if (event.target === experienceLightbox) experienceLightbox.close();
        });
      }
    </script>
  </body>
</html>
