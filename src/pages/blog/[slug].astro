---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import LanguageSwitch from "../../components/LanguageSwitch.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);
  const translations = new Map(
    allPosts
      .filter((post) => post.data.language === "vi")
      .map((post) => [post.data.translationKey ?? post.id, post]),
  );
  const posts = allPosts.filter((post) => post.data.language === "en");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      translation: translations.get(post.data.translationKey ?? post.id),
    },
  }));
}

const { post, translation } = Astro.props;
const { Content: EnglishContent } = await render(post);
const VietnameseContent = translation ? (await render(translation)).Content : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f5f3ec" />
    <meta name="description" content={post.data.description} />
    <title>{post.data.title} — Phuong Pham</title>
  </head>
  <body class="bg-[#f5f3ec] text-[#20372b] antialiased">
    <main class="mx-auto min-h-screen max-w-3xl px-5 sm:px-8">
      <header class="flex items-center justify-between gap-4 py-5">
        <a href="/" class="group flex items-center gap-3" aria-label="Phuong Pham, home">
          <span class="flex size-10 items-center justify-center rounded-full bg-[#20372b] text-lg font-semibold text-[#cfe8b3] transition-transform group-hover:rotate-12">P</span>
          <span class="text-sm font-semibold tracking-wide">PHUONG PHAM</span>
        </a>
        <a href="/#blog" class="inline-flex items-center gap-2 rounded-full border border-[#20372b]/15 px-4 py-2.5 text-sm font-semibold transition-colors hover:bg-white">
          <span aria-hidden="true">←</span>
          All stories
        </a>
        <LanguageSwitch />
      </header>

      <article class="py-12 sm:py-20">
        <a href="/#blog" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#789257]">Stories / Blog</a>
        <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          <span data-language-content="en">{post.data.title}</span>
          {translation && <span data-language-content="vi" hidden>{translation.data.title}</span>}
        </h1>
        <p class="mt-5 text-lg leading-8 text-[#687469]">
          <span data-language-content="en">{post.data.description}</span>
          {translation && <span data-language-content="vi" hidden>{translation.data.description}</span>}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-[#687469]">
          {post.data.category && <span class="rounded-full bg-[#e5eadc] px-3 py-1.5 font-medium text-[#456047]">{post.data.category}</span>}
          {post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}</time>}
        </div>

        <div class="blog-content mt-12 border-t border-[#20372b]/10 pt-8 sm:mt-16 sm:pt-10" data-language-content="en">
          <EnglishContent />
        </div>
        {translation && (
          <div class="blog-content mt-12 border-t border-[#20372b]/10 pt-8 sm:mt-16 sm:pt-10" data-language-content="vi" hidden>
            {VietnameseContent && <VietnameseContent />}
          </div>
        )}

        <a href="/#blog" class="mt-12 inline-flex items-center gap-2 rounded-full bg-[#20372b] px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-[#456047]">
          <span aria-hidden="true">←</span>
          Back to all stories
        </a>
      </article>
    </main>
  </body>
</html>

<style>
  .blog-content :global(h2) {
    margin-top: 2rem;
    color: #20372b;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .blog-content :global(p),
  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin-top: 1rem;
    color: #596a5c;
    font-size: 1rem;
    line-height: 1.9;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    padding-left: 1.5rem;
  }

  .blog-content :global(ul) {
    list-style: disc;
  }

  .blog-content :global(ol) {
    list-style: decimal;
  }

  .blog-content :global(a) {
    color: #456047;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-content :global(img) {
    margin-top: 1.5rem;
    height: auto;
    max-width: 100%;
    border-radius: 1rem;
  }

  .blog-content :global(strong) {
    color: #20372b;
  }
</style>
